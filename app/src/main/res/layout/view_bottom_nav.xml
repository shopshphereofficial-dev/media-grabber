<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#802EE6FF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:stateListAnimator="@null"
            android:text="⌂ HOME"
            android:textColor="@color/neon_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNavFiles"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:stateListAnimator="@null"
            android:text="📁 FILES"
            android:textColor="@color/neon_lime"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:stateListAnimator="@null"
            android:text="⚙ SETTINGS"
            android:textColor="@color/neon_yellow"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
