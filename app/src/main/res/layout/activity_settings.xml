<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="10dp"
        android:shadowColor="#FF2EE6FF"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"
        android:text="⚙ SETTINGS"
        android:textColor="@color/neon_yellow"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <Button
                android:id="@+id/btnAskQuality"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_btn_paste"
                android:stateListAnimator="@null"
                android:text="Ask quality before download: ON"
                android:textColor="@color/neon_yellow"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDefaultQuality"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_btn_paste"
                android:stateListAnimator="@null"
                android:text="Default quality: Best available"
                android:textColor="@color/neon_lime"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnUpdateEngine"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_btn_paste"
                android:stateListAnimator="@null"
                android:text="🔄 Update engine now"
                android:textColor="@color/neon_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnClearHistory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_btn_paste"
                android:stateListAnimator="@null"
                android:text="🗑 Clear download history"
                android:textColor="@color/neon_pink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:padding="20dp"
                android:text="Media Grabber v1.4\nTurbo downloads powered by yt-dlp + aria2c (16 connections)\nFor personal use of your own content only. Do not redistribute downloaded content."
                android:textColor="#9FB4D8"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_nav" />

</LinearLayout>
